{
    "service": "devcontainer",
    "dockerComposeFile": "compose.yaml",
    "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
    "features": {
        "ghcr.io/devcontainers/features/docker-in-docker:4": {
            "version": "latest", // To match the host's Docker version.
            "dockerDashComposeVersion": "v2"
        }
    },
    "initializeCommand": ["bash", "-c", "mkdir --parents $HOME/.ssh; touch $HOME/.ssh/id_ed25519.pub"],
    "postCreateCommand": "lefthook install && bash scripts/health-check.sh",
    "mounts": [
        {
            "type": "bind",
            "source": "${localEnv:HOME}/.ssh/id_ed25519.pub",
            "target": "/home/vscode/.ssh/id_ed25519.pub"
        }
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                "GitHub.copilot-chat",
                "redhat.vscode-yaml",
                "bierner.markdown-checkbox",
                "bierner.markdown-preview-github-styles",
                "streetsidesoftware.code-spell-checker",
                "streetsidesoftware.code-spell-checker-spanish",
                "oxc.oxc-vscode",
                "docker.docker",
                "ms-azuretools.vscode-docker",
                "bierner.markdown-mermaid",
                "EditorConfig.EditorConfig",
                "eamodio.gitlens",
                "github.vscode-github-actions",
                "pflannery.vscode-versionlens",
                "bierner.markdown-emoji",
                "stackbreak.comment-divider",
                "SanjulaGanepola.github-local-actions",
                "ms-python.python",
                "ms-python.debugpy",
                "ms-python.vscode-python-envs",
                "ms-python.vscode-pylance",
                "charliermarsh.ruff",
                "tamasfe.even-better-toml"
            ],
            "settings": {
                "editor.defaultFormatter": "oxc.oxc-vscode",
                "[python]": {
                    "editor.defaultFormatter": "charliermarsh.ruff",
                    "editor.codeActionsOnSave": {
                        "source.fixAll.ruff": "explicit",
                        "source.organizeImports.ruff": "explicit"
                    }
                },
                "telemetry.telemetryLevel": "off",
                "telemetry.feedback.enabled": false,
                "oxc.path.oxfmt": "/home/vscode/.local/share/pnpm/bin/oxfmt",
                "yaml.schemas": {
                    "https://raw.githubusercontent.com/rendercv/rendercv/refs/tags/v2.8/schema.json": ["resumes/*.yaml"]
                }
            }
        }
    }
}
