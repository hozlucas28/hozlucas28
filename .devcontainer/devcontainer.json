{
    "service": "devcontainer",
    "dockerComposeFile": "compose.yaml",
    "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
    "features": {
        "ghcr.io/devcontainers/features/docker-in-docker:4": {
            "version": "latest", // To match the host's Docker version.
            "dockerDashComposeVersion": "v2"
        }
    },
    "postCreateCommand": "lefthook install && bash scripts/health-check.sh",
    "customizations": {
        "vscode": {
            "extensions": [
                "GitHub.copilot-chat",
                "redhat.vscode-yaml",
                "bierner.markdown-checkbox",
                "bierner.markdown-preview-github-styles",
                "streetsidesoftware.code-spell-checker",
                "streetsidesoftware.code-spell-checker-spanish",
                "oxc.oxc-vscode",
                "docker.docker",
                "ms-azuretools.vscode-docker",
                "EditorConfig.EditorConfig",
                "github.vscode-github-actions",
                "bierner.markdown-emoji",
                "stackbreak.comment-divider",
                "SanjulaGanepola.github-local-actions",
                "ms-python.python",
                "ms-python.debugpy",
                "ms-python.vscode-python-envs",
                "ms-python.vscode-pylance",
                "charliermarsh.ruff",
                "tamasfe.even-better-toml"
            ],
            "settings": {
                "editor.defaultFormatter": "oxc.oxc-vscode",
                "[python]": {
                    "editor.defaultFormatter": "charliermarsh.ruff",
                    "editor.codeActionsOnSave": {
                        "source.fixAll.ruff": "explicit",
                        "source.organizeImports.ruff": "explicit"
                    }
                },
                "oxc.path.oxfmt": "/home/vscode/.local/share/pnpm/bin/oxfmt",
                "yaml.schemas": {
                    "https://raw.githubusercontent.com/rendercv/rendercv/refs/tags/v2.8/schema.json": ["resumes/*.yaml"]
                }
            }
        }
    }
}
